body {
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', Arial, sans-serif;
    background: #0f172a;
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    overflow: hidden;
}

.arena {
    width: 100%;
    max-width: 900px;
    background: linear-gradient(to bottom, #1e293b, #0f172a);
    border: 4px solid #475569;
    border-radius: 16px;
    padding: 20px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
}

.battle-header {
    text-align: center;
    border-bottom: 2px dashed #334155;
    padding-bottom: 10px;
}
.vs-title { color: #f59e0b; margin: 5px 0; font-size: 28px; letter-spacing: 2px; }

.scoreboard {
    display: flex;
    justify-content: space-between;
    margin: 15px 0;
}
.player-info {
    padding: 10px 20px;
    border-radius: 8px;
    background: rgba(255,255,255,0.05);
    min-width: 180px;
}
.p1-color { border-left: 5px solid #3b82f6; text-align: left;}
.p2-color { border-right: 5px solid #ef4444; text-align: right;}
.controls { font-size: 12px; color: #94a3b8; font-weight: bold; }

/* Arena Pertempuran Magic Chess Grid Effect */
.battleground {
    height: 200px;
    background: #1e293b;
    background-image: 
        linear-gradient(rgba(255,255,255,0.05) 2px, transparent 2px),
        linear-gradient(90deg, rgba(255,255,255,0.05) 2px, transparent 2px);
    background-size: 40px 40px;
    background-position: center;
    border-radius: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 60px;
    position: relative;
    border: 2px solid #334155;
}

/* Desain Monster Sederhana Bergaya Catur Komponen */
.monster {
    width: 60px;
    height: 70px;
    border-radius: 15px 15px 5px 5px;
    position: relative;
    transition: transform 0.2s ease-in-out;
}
.P1 { background: #2563eb; box-shadow: 0 0 20px #3b82f6; }
.P2 { background: #dc2626; box-shadow: 0 0 20px #ef4444; }

.monster-eye {
    width: 12px; height: 12px; background: white; border-radius: 50%;
    position: absolute; top: 15px;
}
.P1 .monster-eye { right: 15px; border-right: 3px solid black; }
.P2 .monster-eye { left: 15px; border-left: 3px solid black; }

.monster-weapon {
    position: absolute; top: -10px; font-size: 24px;
}
.P1 .monster-weapon { right: -20px; transform: scaleX(-1); }
.P2 .monster-weapon { left: -20px; }

/* Animasi Serangan */
.attack-p1 { transform: translateX(250px) scale(1.2); }
.attack-p2 { transform: translateX(-250px) scale(1.2); }

.hit-effect {
    position: absolute; left: 50%; top: 40%;
    transform: translate(-50%, -50%);
    font-size: 60px;
    z-index: 10;
}

/* Box Pertanyaan */
.question-container {
    display: flex; justify-content: center; margin: 20px 0;
}
#question-box {
    background: #f59e0b; color: #0f172a;
    font-size: 46px; font-weight: bold;
    padding: 15px 50px; border-radius: 30px;
    box-shadow: 0 0 15px #f59e0b;
}

/* Panel Kontrol/Tombol */
.controls-container {
    display: flex; justify-content: space-between; gap: 40px;
}
.options-side {
    flex: 1; text-align: center;
    background: rgba(255,255,255,0.02);
    padding: 10px; border-radius: 12px;
}
.options-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 5px;
}
.options-grid button {
    padding: 12px; font-size: 18px; font-weight: bold; color: white;
    border: none; border-radius: 8px; cursor: pointer;
}
.btn-p1 { background: #3b82f6; border-bottom: 4px solid #1d4ed8; }
.btn-p2 { background: #ef4444; border-bottom: 4px solid #b91c1c; }

.hidden { display: none !important; }

/* Modal Game Over */
.modal {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.85); display: flex; justify-content: center; align-items: center; z-index: 100;
}
.modal-content {
    background: #1e293b; padding: 40px; border-radius: 16px; text-align: center;
    border: 3px solid #f59e0b; max-width: 400px; width: 100%;
}
.modal-content button {
    background: #f59e0b; color: #0f172a; font-size: 18px; font-weight: bold;
    border: none; padding: 12px 30px; border-radius: 8px; cursor: pointer; margin-top: 20px;
}
